# ---- TrueForge ----------------------------------------------------------
TRUEFORGE_BASE_URL=http://localhost:8790
RATCHET_MODEL=anthropic/claude-sonnet-4-6

# model keys are configured inside TrueForge (Settings -> Model providers),
# not here -- the harness owns provider credentials on purpose.

# ---- Ratchet ------------------------------------------------------------
RATCHET_REPO=demo-repo
RATCHET_TASK=tasks/demo-001-slugify/task.yaml
RATCHET_BACKEND=docker           # docker | local  (local skips isolation; demo fallback)
RATCHET_MCP_HOST=127.0.0.1
RATCHET_MCP_PORT=8931
RATCHET_BASE_BRANCH=main
RATCHET_REMOTE=origin

# ---- Bright Data --------------------------------------------------------
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=mcp_unlocker
