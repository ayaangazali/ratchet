# ---- TrueForge ----------------------------------------------------------
TRUEFORGE_BASE_URL=http://localhost:8790

# Model provider keys are configured inside TrueForge (Settings -> Model providers),
# not here. The harness owns provider credentials on purpose.

# Model routing by role. Fan-out branches deliberately use different providers, so
# diversity is structural rather than a sampling artefact.
RATCHET_MODEL_CARTOGRAPHER=openai/gpt-5-mini
RATCHET_MODEL_REVIEWER=openai/gpt-5-mini
RATCHET_GENERATORS=anthropic/claude-sonnet-4-6,openai/gpt-5.2,google-gemini/gemini-3-pro

# ---- what we are working on --------------------------------------------
RATCHET_REPO=demo-repo
RATCHET_TASK=tasks/demo-001-slugify/task.yaml

# ---- where patches run --------------------------------------------------
# auto = try the harness sandbox provider, fall back to git worktrees
RATCHET_PROVIDER=auto
RATCHET_VENV=

# ---- budgets, enforced hard and shown in the UI at all times ------------
RATCHET_MAX_NODES=40
RATCHET_MAX_SECONDS=900
RATCHET_MAX_USD=3
RATCHET_PATIENCE=3

# ---- Bright Data --------------------------------------------------------
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=mcp_unlocker
