/* Ratchet console theme -- ocean blue.
   The colours are the ones in `mascot.py`; if you change one, change it there
   too, because the web dashboard reads them from that module.

   Two rules govern the layout. The gauntlet is never scrolled off screen, and
   the approval gate is the only thing allowed to take the full width. */

/* The console never scrolls as a whole. Every pane owns its own overflow, so a
   short terminal loses the bottom of a pane rather than sliding the header off. */
Screen {
    background: #0d1219;
    color: #dce8f5;
    layout: vertical;
    overflow: hidden hidden;
}

/* ----------------------------------------------------------------- header -- */

#banner {
    height: auto;
    padding: 0 2;
    margin: 0 1;
    background: #141c26;
    border: round #2a5f8f;
}

/* ------------------------------------------------------------------- body -- */

#main {
    height: 1fr;
    min-height: 8;
    padding: 0 1;
}

#left {
    width: 34;
    min-width: 26;
}

#right {
    width: 36;
    min-width: 28;
}

#activity-box {
    width: 1fr;
    min-width: 30;
}

#tree-box, #activity-box, #counters, #gauntlet, #waiting {
    border: round #26323f;
    background: #141c26;
    border-title-color: #93a7bd;
    border-title-align: left;
    border-title-style: bold;
    padding: 0 1;
}

/* The tree keeps its rows even when everything else is squeezed: it is the
   answer to "where has this been", and a console that cannot answer that is
   just a log. */
#tree-box { height: 1fr; min-height: 5; overflow-x: hidden; }
#counters { height: auto; padding: 1; }
#counters.-compact { padding: 0 1; }
#gauntlet { height: auto; padding: 1 1 0 1; }
#waiting  { height: 1fr; min-height: 4; padding: 1; }
#activity-box { padding: 0 1; }

#tree { height: auto; }

/* RichLog scrolls itself. Wrapping it in a scroll container as well gives you
   two scrollbars and an auto-scroll that never reaches the bottom. */
#activity {
    height: 1fr;
    background: #141c26;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

Screen, VerticalScroll, RichLog {
    scrollbar-background: #141c26;
    scrollbar-background-hover: #141c26;
    scrollbar-background-active: #141c26;
    scrollbar-color: #26323f;
    scrollbar-color-hover: #2a5f8f;
    scrollbar-color-active: #4d9fe8;
}

/* --------------------------------------------------------- the gate, armed -- */

/* Full width, warm border, and it does not go away until somebody decides.
   This is the interaction the whole project exists to make possible. */
/* Capped on purpose. The gate has to dominate without erasing the run behind
   it -- a reviewer who cannot see the tree cannot judge the diff. */
#approval {
    display: none;
    height: auto;
    max-height: 17;
    margin: 0 1;
    padding: 1 2;
    background: #1a2532;
    border: round #4d9fe8;
}

#approval-head   { height: auto; padding-bottom: 1; }
#approval-diff   { height: auto; max-height: 7; padding-bottom: 1; }
#approval-choices{ height: auto; }

#approval-buttons { height: auto; padding-top: 1; }
#approval-buttons Button { margin-right: 2; min-width: 14; }

/* ------------------------------------------------------------------ chrome -- */

#status {
    height: 1;
    padding: 0 2;
    background: #0d1219;
}

#hints {
    height: 1;
    padding: 0 2;
    background: #0d1219;
}

/* Fixed-width panes clip rather than wrap. A wrapped tree stops looking like a
   tree, and a wrapped stage rail spills its own text outside its border. */
#banner, #tree, #gauntlet, #waiting, #counters, #status, #hints {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}


/* the debug panel: hidden until /debug, and never taller than a third of the
   activity column -- it is a diagnostic, not the main event */
#debug {
    display: none;
    height: 30%;
    max-height: 14;
    border: round #26323f;
    border-title-color: #93a7bd;
    background: #0d1219;
    color: #5f7186;
    padding: 0 1;
}


/* Narrow terminal: the three columns become one, and every pane keeps its place
   in the reading order -- tree, then the work, then how it is being judged. The
   alternative was hiding two of them, which is how the console came to look
   broken on an ordinary 80-column window. */
#main.stacked {
    layout: vertical;
}

#main.stacked #left {
    width: 100%;
    height: auto;
    max-height: 30%;
}

#main.stacked #activity-box {
    width: 100%;
    height: 1fr;
    min-height: 8;
}

#main.stacked #right {
    width: 100%;
    height: auto;
    max-height: 40%;
}

#main.stacked #tree-box {
    max-height: 8;
}
